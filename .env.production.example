# Production reference ONLY — not loaded by the app (config/index.ts skips
# dotenv entirely when NODE_ENV=production, see the comment there) and must
# NEVER be filled in and committed as a real .env.production file. This just
# documents which variables the hosting platform's own environment/secret
# manager needs to have set before `npm run build && npm start` is run there.
# `npm start` sets NODE_ENV=production itself (see package.json) — the
# platform doesn't need to set that one.

# App
PORT=4000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=30m
OTP_EXPIRY_MINUTES=10

# Redis (OTP storage + rate limiting)
REDIS_URL=

# MOCK_AUTH is hard-disabled whenever NODE_ENV=production regardless of this
# value (see config/index.ts) — not included here since it can never do
# anything in a real production deployment.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio — needs the production/paid tier, not trial (see CLAUDE.md "Twilio
# trial mode" — trial SMS only reaches manually-verified numbers, and
# WhatsApp stays Sandbox-only until Meta's separate Business API approval)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
