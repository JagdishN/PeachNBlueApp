generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BranchType {
  apartment
  area
}

enum UserRole {
  staff
  admin
}

enum BillingMode {
  daily
  monthly_billing
}

enum ChargeType {
  bag_replacement
}

enum OrderInternalStatus {
  picked_up
  washing
  ironing
  ready
  out_for_delivery
  delivered
  cancelled
}

enum OrderPaymentStatus {
  pending
  paid
  partially_paid
  due
}

enum PaymentMethod {
  qr_online
  cash
}

enum PaymentType {
  order_payment
  monthly_settlement
  partial_settlement
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum LedgerEntryType {
  charge
  payment
  adjustment
}

enum CommunicationMessageType {
  pickup_confirmation
  amount_revision
  delivery_confirmation
  payment_receipt
  monthly_statement
  payment_reminder
}

enum CommunicationChannel {
  whatsapp
  sms
}

enum CommunicationStatus {
  sent
  failed
}

model Branch {
  id               String             @id @default(uuid()) @db.Uuid
  branchName       String             @db.VarChar(150)
  branchType       BranchType
  phoneNumber      String             @db.VarChar(15)
  whatsappNumber   String?            @db.VarChar(15)
  address          String
  city             String             @db.VarChar(100)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  users            User[]             @relation("BranchUsers")
  customers        Customer[]
  garmentCatalogue GarmentCatalogue[]

  @@index([phoneNumber])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  role         UserRole
  branch       Branch?  @relation("BranchUsers", fields: [branchId], references: [id])
  branchId     String?  @db.Uuid
  fullName     String   @db.VarChar(150)
  phoneNumber  String   @unique @db.VarChar(15)
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdOrders Order[] @relation("CreatedOrders")
  assignedOrders Order[] @relation("StaffOrders")
  payments     Payment[]
  staffEarnings StaffEarning[]
  statusChanges OrderStatusHistory[]
  amountRevisions OrderAmountRevision[]
  deviceTokens DeviceToken[]
  additionalChargesCreated AdditionalCharge[]
}

// Not present in database_schema_v3.sql — new for FCM/Expo push support.
// One row per device a user has registered for push, keyed by the push
// token itself (re-registering the same physical device updates userId
// rather than creating a duplicate row, e.g. if a different staff member
// logs into a shared device).
model DeviceToken {
  id            String   @id @default(uuid()) @db.Uuid
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @db.Uuid
  expoPushToken String   @unique
  platform      String   @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  fullName       String    @db.VarChar(150)
  phoneNumber    String    @db.VarChar(15)
  whatsappNumber String?   @db.VarChar(15)
  branch         Branch    @relation(fields: [branchId], references: [id])
  branchId       String    @db.Uuid
  locationLabel  String    @db.VarChar(100)
  billingMode    BillingMode @default(daily)
  creditLimit    Decimal   @default("0") @db.Decimal(10, 2)
  bagIssued      Boolean   @default(false)
  bagIssuedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
  payments       Payment[]
  ledgerEntries  LedgerEntry[]
  monthlyStatements MonthlyStatement[]
  communicationsLog CommunicationLog[]
  additionalCharges AdditionalCharge[]

  @@unique([phoneNumber, branchId, locationLabel])
  @@index([phoneNumber])
  @@index([branchId, locationLabel])
}

model GarmentCatalogue {
  id           String   @id @default(uuid()) @db.Uuid
  branch       Branch?  @relation(fields: [branchId], references: [id])
  branchId     String?  @db.Uuid
  itemName     String   @db.VarChar(100)
  // Deliberately a plain string, not a hard DB enum — see CLAUDE.md "Services —
  // RESOLVED". Seed values: wash_fold, ironing, dry_clean, specialty_care.
  serviceType  String   @default("wash_fold") @db.VarChar(30)
  price        Decimal  @db.Decimal(8, 2)
  // Set alongside `price` only for items priced as a range (e.g. Designer
  // Dress ₹80–₹150) — staff choose the final price within [price, priceMax]
  // at order creation instead of using `price` directly.
  priceMax     Decimal? @db.Decimal(8, 2)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orderItems   OrderItem[]

  @@index([branchId])
}

model Order {
  id              String             @id @default(uuid()) @db.Uuid
  orderNumber     String             @unique @db.VarChar(20)
  customer        Customer           @relation(fields: [customerId], references: [id])
  customerId      String             @db.Uuid
  createdBy       User               @relation("CreatedOrders", fields: [createdById], references: [id])
  createdById     String             @db.Uuid
  staff           User?              @relation("StaffOrders", fields: [staffId], references: [id])
  staffId         String?            @db.Uuid
  internalStatus  OrderInternalStatus @default(picked_up)
  pickupDate      DateTime
  deliveryDate    DateTime?
  estimatedAmount Decimal            @default("0") @db.Decimal(10, 2)
  finalAmount     Decimal            @default("0") @db.Decimal(10, 2)
  amountWasRevised Boolean           @default(false)
  paymentMethod   PaymentMethod?
  paymentStatus   OrderPaymentStatus @default(pending)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  statusHistory   OrderStatusHistory[]
  amountRevisions OrderAmountRevision[]
  orderItems      OrderItem[]
  payments        Payment[]
  ledgerEntries   LedgerEntry[]
  invoice         Invoice?
  communications  CommunicationLog[]
  additionalCharges AdditionalCharge[]

  @@index([customerId])
  @@index([staffId])
  @@index([internalStatus])
}

model OrderStatusHistory {
  id        String   @id @default(uuid()) @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String   @db.Uuid
  status    String   @db.VarChar(30)
  changedBy User?    @relation(fields: [changedById], references: [id])
  changedById String? @db.Uuid
  changedAt DateTime @default(now())
}

model OrderAmountRevision {
  id         String   @id @default(uuid()) @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String   @db.Uuid
  oldAmount  Decimal  @db.Decimal(10, 2)
  newAmount  Decimal  @db.Decimal(10, 2)
  reason     String
  revisedBy  User     @relation(fields: [revisedById], references: [id])
  revisedById String  @db.Uuid
  revisedAt  DateTime @default(now())

  @@index([orderId])
}

// Non-garment, order-independent charges (e.g. the ₹350 bag replacement
// fee) — kept separate from OrderItem/garment_catalogue since these aren't
// laundry services. orderId is optional because a bag can be lost/damaged
// outside the context of any specific pickup/delivery.
model AdditionalCharge {
  id          String     @id @default(uuid()) @db.Uuid
  customer    Customer   @relation(fields: [customerId], references: [id])
  customerId  String     @db.Uuid
  order       Order?     @relation(fields: [orderId], references: [id])
  orderId     String?    @db.Uuid
  chargeType  ChargeType
  amount      Decimal    @db.Decimal(8, 2)
  description String?
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdById String     @db.Uuid
  createdAt   DateTime   @default(now())

  @@index([customerId])
  @@index([orderId])
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String   @db.Uuid
  garment    GarmentCatalogue @relation(fields: [garmentId], references: [id])
  garmentId  String   @db.Uuid
  itemName   String   @db.VarChar(100)
  quantity   Int
  unitPrice  Decimal  @db.Decimal(8, 2)
  lineTotal  Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  order           Order?   @relation(fields: [orderId], references: [id])
  orderId         String?  @db.Uuid
  customer        Customer @relation(fields: [customerId], references: [id])
  customerId      String   @db.Uuid
  amount          Decimal  @db.Decimal(10, 2)
  paymentType     PaymentType
  paymentMethod   PaymentMethod
  razorpayPaymentId String? @db.VarChar(100)
  razorpayOrderId  String? @db.VarChar(100)
  status          PaymentStatus @default(pending)
  recordedBy      User     @relation(fields: [recordedById], references: [id])
  recordedById    String   @db.Uuid
  notes           String?
  createdAt       DateTime @default(now())

  @@index([customerId])
  @@index([orderId])
}

model LedgerEntry {
  id           String   @id @default(uuid()) @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id])
  customerId   String   @db.Uuid
  order        Order?   @relation(fields: [orderId], references: [id])
  orderId      String?  @db.Uuid
  entryType    LedgerEntryType
  amount       Decimal  @db.Decimal(10, 2)
  balanceAfter Decimal  @db.Decimal(10, 2)
  description  String?
  createdAt    DateTime @default(now())

  @@index([customerId, createdAt])
}

model MonthlyStatement {
  id             String   @id @default(uuid()) @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id])
  customerId     String   @db.Uuid
  statementMonth DateTime
  openingBalance Decimal  @default("0") @db.Decimal(10, 2)
  totalCharges   Decimal  @default("0") @db.Decimal(10, 2)
  totalPaid      Decimal  @default("0") @db.Decimal(10, 2)
  closingBalance Decimal  @default("0") @db.Decimal(10, 2)
  pdfUrl         String?
  whatsappSentAt DateTime?
  reminderSentAt DateTime?
  generatedAt    DateTime @default(now())

  @@unique([customerId, statementMonth])
  @@index([customerId])
}

model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String   @db.Uuid @unique
  invoiceNumber String @unique @db.VarChar(30)
  pdfUrl      String?
  qrCodeUrl   String?
  createdAt   DateTime @default(now())
}

model CommunicationLog {
  id           String                      @id @default(uuid()) @db.Uuid
  customer     Customer                    @relation(fields: [customerId], references: [id])
  customerId   String                      @db.Uuid
  order        Order?                      @relation(fields: [orderId], references: [id])
  orderId      String?                     @db.Uuid
  messageType  CommunicationMessageType
  channel      CommunicationChannel
  status       CommunicationStatus        @default(sent)
  sentAt       DateTime                   @default(now())

  @@index([customerId, sentAt])
}

model StaffEarning {
  id             String   @id @default(uuid()) @db.Uuid
  staff          User     @relation(fields: [staffId], references: [id])
  staffId        String   @db.Uuid
  earningDate    DateTime
  ordersCompleted Int     @default(0)
  totalCollected Decimal  @default("0") @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@unique([staffId, earningDate])
}
