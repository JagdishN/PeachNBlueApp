# App
PORT=4000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=30m
OTP_EXPIRY_MINUTES=10

# Redis (OTP storage + rate limiting) — see README "Redis setup"
REDIS_URL=redis://localhost:6379

# Local testing only — bypasses the DB user lookup and Redis OTP storage with
# an in-memory mock admin. Ignored if NODE_ENV=production.
MOCK_AUTH=false

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio — used for BOTH WhatsApp and SMS (sent together on every notification, never as a fallback pair)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
