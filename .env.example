# App
PORT=4000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=30m
OTP_EXPIRY_MINUTES=10

# Redis (OTP storage + rate limiting) — see README "Redis setup"
REDIS_URL=redis://localhost:6379

# Local testing only — bypasses the DB user lookup and Redis OTP storage with
# an in-memory mock admin. Ignored if NODE_ENV=production.
MOCK_AUTH=false

# Supabase
SUPABASE_URL=
# New-style API keys (sb_publishable_… / sb_secret_…) used by @supabase/server,
# replacing the older JWT-based anon/service_role keys below.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MSG91 — WhatsApp only (CLAUDE.md "Messaging migration — MSG91,
# WhatsApp-only"). SMS is no longer sent anywhere, including OTP login.
# MSG91_INTEGRATED_NUMBER is the shared/default sending number, used only
# when a branch has no whatsappNumber of its own configured yet — each
# branch should ideally have its own number registered under the same
# MSG91/Meta WABA (CLAUDE.md "Branches").
MSG91_AUTH_KEY=
MSG91_INTEGRATED_NUMBER=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
